{
  // The inner loop: the sources as written - v750 syntax, which the
  // downport rule keeps downportable to 7.02. The two release gates run
  // from .github/abaplint: abap_cloud.jsonc (ABAP Cloud, released APIs only)
  // and abap_702.jsonc (the downported copy, see .github/scripts/check-702.sh).
  "global": {
    "files": "/src/**/*.*"
  },
  "dependencies": [
    {
      "url": "https://github.com/abapedia/steampunk-2305-api-intersect-702",
      "folder": "/deps",
      "files": "/src/**/*.*"
    },
    {
      // A release tag, not main: users install a release next to this addon
      // (abap2UI5 CONVENTIONS §9). scripts/core-pin.mjs reads and moves it in
      // every abaplint config at once, bump-core moves it weekly after the gates
      // passed on the new tag, and the weekly canary run lints once against main.
      "url": "https://github.com/abap2UI5/abap2UI5",
      "branch": "1.148.0",
      "folder": "/abap2UI5",
      "files": "/src/**/*.*"
    },
    {
      "url": "https://github.com/abap2UI5-addons/popups",
      "folder": "/popups",
      "files": "/src/**/*.*"
    },
    {
      "url": "https://github.com/abap2UI5-addons/layout-management",
      "folder": "/layout-management",
      "files": "/src/**/*.*"
    }
  ],
  "syntax": {
    "version": "v750",
    "errorNamespace": "."
  },
  "rules": {
    "wrong_abapdoc_position": true,
    "downport": true,
    "begin_end_names": true,
    "check_ddic": true,
    "check_include": true,
    "check_syntax": true,
    "global_class": true,
    "definitions_top": false,
    "implement_methods": true,
    "method_implemented_twice": true,
    "parser_error": true,
    "superclass_final": true,
    "unknown_types": true,
    "whitespace_end": true,
    "xml_consistency": true,
    "exporting": true,
    "omit_parameter_name": true,
    "prefix_is_current_class": true,
    // z2ui5_cl_cgui_frontend keeps the whole signature of
    // CL_GUI_FRONTEND_SERVICES, z2ui5_cl_cgui_gui* the ones of the SAP GUI
    // controls - a converted call passes what the classic one did, used or
    // not - and its constants
    "unused_variables": {
      "exclude": ["z2ui5_cl_cgui_frontend", "z2ui5_cl_cgui_gui"]
    },
    "unused_types": true,
    "unused_methods": true,
    "use_new": true,
    "prefer_xsdbool": true,
    "line_length": {
      "length": 255
    },
    // classes, the interface of the variant store and the packages - no
    // programs, no dictionary objects: everything is ABAP Cloud ready
    "allowed_object_types": {
      "allowed": ["CLAS", "INTF", "DEVC", "TABL", "DTEL"]
    },
    "allowed_object_naming": true,
    "object_naming": {
      "clas": "^Z2UI5_C[LX]_CGUI_",
      "intf": "^Z2UI5_IF_CGUI_",
      "patternKind": "required",
      "ignoreNames": [],
      "ignorePatterns": []
    },
    // --- from abap2UI5's rule set (abap2UI5/abaplint.jsonc) ---
    "add_test_attributes": true,
    "aff_and_xml": true,
    "ambiguous_statement": true,
    "begin_single_include": true,
    "call_transaction_authority_check": true,
    "catch_and_raise": true,
    "cds_association_name": true,
    "cds_field_order": true,
    "cds_parser_error": true,
    "chain_mainly_declarations": true,
    "change_if_to_case": true,
    "check_abstract": true,
    "check_comments": true,
    "check_text_elements": true,
    "check_transformation_exists": true,
    "classic_exceptions_overlap": true,
    // clipboard_export( ) of CL_GUI_FRONTEND_SERVICES reads its EXPORTING data
    "clear_exporting_parameters": {
      "exclude": ["z2ui5_cl_cgui_frontend", "z2ui5_cl_cgui_gui"]
    },
    "cloud_types": true,
    "colon_missing_space": true,
    "constant_classes": true,
    "constructor_visibility_public": true,
    "contains_tab": true,
    "cyclic_oo": {
      "exclude": [],
      "skip": [
        "Z2UI5_IF_APP",
        "Z2UI5_IF_CLIENT",
        "Z2UI5_CL_UI5_ACTION",
        "Z2UI5_CL_UI5_HANDLER"
      ],
      "skipSharedMemory": true,
      "skipTestclasses": true
    },
    "db_operation_in_loop": true,
    "description_empty": true,
    "dynpro_checks": true,
    "easy_to_find_messages": true,
    "else_after_all_returns": true,
    "empty_event": true,
    "empty_statement": true,
    "empty_structure": {
      "loop": false,
      "if": true,
      "while": true,
      "case": true,
      "select": false,
      "do": true,
      "at": true,
      "try": true,
      "when": false,
      "catch": true
    },
    "exit_or_check": true,
    "expand_macros": true,
    "fm_global_parameters_obsolete": true,
    "forbidden_identifier": true,
    "forbidden_pseudo_and_pragma": {
      "exclude": [],
      "ignoreGlobalClassDefinition": false,
      "ignoreGlobalInterface": false,
      "pragmas": [],
      "pseudo": [],
      "severity": "Error"
    },
    "forbidden_void_type": {
      "check": [
        "^boole_d$",
        "^char10$",
        "^char12$",
        "^char2$",
        "^char20$",
        "^char30$",
        "^char4$",
        "^char50$",
        "^char70$",
        "^cl_abap_syst",
        "^cl_aff_",
        "^cl_aucv_test_runner_abstract$",
        "^cl_aucv_test_runner_standard$",
        "^cl_aunit_assert$",
        "^cl_axt_dbtable$",
        "^cl_blue_wb_utility$",
        "^cl_oo_source$",
        "^/ui2/cl_",
        "^cl_saunit_internal_result$",
        "^cl_srvd_wb_object_data$",
        "^cl_wb_object_operator_factory$",
        "^cl_wer_const$",
        "^cl_xco_",
        "^cx_aff_",
        "^cx_wb_object_operation_error$",
        "^cx_xco_",
        "^flag$",
        "^i18_a_langiso2$",
        "^if_adt_lock_handle$",
        "^if_aff_",
        "^if_satc_ci_variant_access$",
        "^if_saunit_internal_result$",
        "^if_saunit_internal_result_type$",
        "^if_srvd_types$",
        "^if_wb_adt_plugin_resource_co$",
        "^if_wb_object_data_selection_co$",
        "^if_wb_object_operator$",
        "^if_xco_",
        "^int4$",
        "^numc2$",
        "^sabp_t_tadir_keys$",
        "^sap_bool$",
        "^srcsystem$",
        "^stringtab$",
        "^sychar01$",
        "^sychar10$",
        "^sychar70$",
        "^sydatum$",
        "^sylangu$",
        "^syst_title$",
        "^syuzeit$",
        "^feld$",
        "^abap_boolean$"
      ],
      "exclude": []
    },
    "form_tables_obsolete": true,
    "fully_type_constants": {
      "checkData": true,
      "exclude": []
    },
    "fully_type_itabs": true,
    "function_module_recommendations": true,
    "functional_writing": {
      "exclude": [],
      "ignoreExceptions": true
    },
    "identical_conditions": true,
    "identical_contents": true,
    "identical_descriptions": true,
    "identical_form_names": true,
    "identical_move": true,
    "if_in_if": true,
    "implicit_start_of_selection": true,
    "index_completely_contained": true,
    "inline_data_old_versions": true,
    "invalid_table_index": true,
    "line_break_style": true,
    "local_testclass_consistency": true,
    "macro_naming": true,
    "main_file_contents": true,
    "many_parentheses": true,
    "max_one_method_parameter_per_line": true,
    "max_one_statement": true,
    "method_overwrites_builtin": {
      "exclude": [],
      "severity": "Error"
    },
    "modify_only_own_db_tables": {
      "exclude": [],
      "ownTables": "^[yz]",
      "reportDynamic": true
    },
    "msag_consistency": true,
    "names_no_dash": true,
    "nesting": {
      "depth": 5,
      "exclude": []
    },
    "no_aliases": true,
    "no_chained_assignment": true,
    "no_comments_between_methods": true,
    "no_external_form_calls": true,
    "nrob_consistency": true,
    "obsolete_statement": true,
    "omit_preceding_zeros": true,
    "omit_receiving": true,
    "parser_702_chaining": true,
    "parser_bad_exceptions": true,
    "parser_missing_space": true,
    "pragma_style": true,
    "prefer_abap_bool": true,
    "prefer_abap_bool_values": true,
    "prefer_pragmas": true,
    "prefer_raise_exception_new": true,
    // get_textmodified_status( ) of CL_GUI_TEXTEDIT exports its status
    "prefer_returning_to_exporting": {
      "exclude": ["z2ui5_cl_cgui_gui"]
    },
    "preferred_compare_operator": true,
    "preferred_parameter_ignored": true,
    "reduce_procedural_code": true,
    "reduce_string_templates": true,
    "redundant_conversion": true,
    "release_idoc": true,
    "remove_descriptions": {
      "exclude": [],
      "ignoreExceptions": false,
      "ignoreWorkflow": false,
      "severity": "Error"
    },
    "rfc_error_handling": true,
    "select_single_full_key": true,
    "selection_screen_naming": true,
    "sequential_blank": {
      "exclude": [],
      "severity": "Warning"
    },
    "sicf_consistency": true,
    "sql_escape_host_variables": true,
    "sql_value_conversion": true,
    "static_call_via_instance": {
      "allowInTestclassIncludes": false,
      "exclude": []
    },
    "superfluous_value": true,
    "sy_modification": true,
    "tabl_enhancement_category": true,
    "tables_declared_locally": true,
    "try_without_catch": true,
    "type_form_parameters": true,
    "uncaught_exception": true,
    "unnecessary_chaining": true,
    "unnecessary_loop_guard": true,
    "unnecessary_pragma": true,
    "unreachable_code": true,
    "unsecure_fae": true,
    "unused_ddic": true,
    "unused_macros": true,
    // z2ui5_cl_cgui_frontend stands in for CL_GUI_FRONTEND_SERVICES and
    // z2ui5_cl_cgui_gui* for the SAP GUI controls, whose classic exceptions
    // the converted reports catch with EXCEPTIONS
    "use_class_based_exceptions": {
      "exclude": ["z2ui5_cl_cgui_frontend", "z2ui5_cl_cgui_gui"]
    },
    "use_message_class": true,
    "when_others_last": true,
    "xml_bom": true
  }
}
