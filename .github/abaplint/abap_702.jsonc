{
  // 7.02 gate - used by .github/scripts/check-702.sh on a scratch copy in
  // build/702, never on src/ itself: `abaplint --fix` downports the copy,
  // then this config checks it with the v702 syntax against the 702 branch
  // abap2UI5 publishes. The addon has no other dependency - its popups are
  // classes of its own.
  "global": {
    "files": ["/src/**/*.*"],
    // the two generated report2UI5 samples fill a table of c LENGTH 255 with
    // VALUE #( ( '...' ) ); the downport writes INSERT '...' INTO TABLE, which
    // is valid ABAP but abaplint's check_syntax reports as "Types not
    // compatible" (abap2UI5 backlog abaplint-downport-value-char-literal) -
    // drop this once abaplint accepts it
    "noIssues": ["/src/03/z2ui5_cl_cgui_r2c_25.clas.abap", "/src/03/z2ui5_cl_cgui_r2c_40.clas.abap"]
  },
  "dependencies": [
    {
      "url": "https://github.com/open-abap/open-abap-core",
      "folder": "/deps",
      "files": "/src/**/*.*"
    },
    {
      // the downported form of the release the other configs pin - moved with
      // them by scripts/core-pin.mjs (abap2UI5 CONVENTIONS §9)
      "url": "https://github.com/abap2UI5/abap2UI5",
      "branch": "702",
      // 1.151.0 - move to the tag once it is cut
      "folder": "/abap2UI5",
      "files": "/src/0[0-2]/**/*.*"
    }
  ],
  "syntax": {
    "version": "v702",
    "errorNamespace": "."
  },
  "rules": {
    "wrong_abapdoc_position": true,
    "downport": true,
    "begin_end_names": true,
    "check_ddic": true,
    "check_include": true,
    "check_syntax": true,
    "global_class": true,
    "definitions_top": true,
    "implement_methods": true,
    "method_implemented_twice": true,
    "parser_error": true,
    "superclass_final": true,
    "unknown_types": true,
    "xml_consistency": true
  }
}
