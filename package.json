{
  "name": "abap-cloud-gui",
  "private": true,
  "version": "1.0.0",
  "description": "Write abap2UI5 apps like classic ABAP reports - selection screens, WRITE lists, ALV grids and report events, on ABAP Cloud and NW 7.02.",
  "scripts": {
    "lint": "abaplint abaplint.jsonc",
    "check:cloud": "abaplint .github/abaplint/abap_cloud.jsonc",
    "check:702": "bash .github/scripts/check-702.sh",
    "check:abap2ui5": "abap2ui5lint",
    "check:regex": "node scripts/check-regex.mjs",
    "check": "npm run lint && npm run check:regex && npm run check:cloud && npm run check:702 && npm run check:abap2ui5",
    "test": "npm run check",
    "report2ui5": "node tools/report2ui5/cli.mjs",
    "report2ui5:coverage": "node tools/report2ui5/coverage.mjs",
    "report2ui5:package": "node tools/report2ui5/package.mjs",
    "report2ui5:web": "node tools/report2ui5/web.mjs",
    "test:report2ui5": "node --test \"tools/report2ui5/test/*.test.mjs\"",
    "report2ui5:docs": "node tools/report2ui5/docs.mjs",
    "test:report2ui5:runtime": "node --test --test-concurrency=1 \"tools/report2ui5/test/runtime/*.test.mjs\"",
    "unit": "node scripts/unit.mjs",
    "site": "node scripts/build-site.mjs",
    "site:dev": "node scripts/build-site.mjs --dev",
    "test:report2ui5:browser": "node --test tools/report2ui5/test/browser/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abap2UI5-addons/abap-cloud-gui.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@abap2ui5/linter": "^0.8.5",
    "@abap2ui5/linter-render": "^0.8.5",
    "@abaplint/cli": "^2.120.75",
    "@abaplint/core": "^2.120.75",
    "@openui5/sap.f": "1.153.0",
    "@openui5/sap.m": "1.153.0",
    "@openui5/sap.tnt": "1.153.0",
    "@openui5/sap.ui.codeeditor": "1.153.0",
    "@openui5/sap.ui.core": "1.153.0",
    "@openui5/sap.ui.layout": "1.153.0",
    "@openui5/sap.ui.table": "1.153.0",
    "@openui5/sap.ui.unified": "1.153.0",
    "@openui5/themelib_sap_horizon": "1.153.0",
    "esbuild": "0.28.1",
    "playwright": "1.63.0",
    "vitepress": "^1.6.4"
  },
  "engines": {
    "node": ">=22"
  }
}
